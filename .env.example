# Invoice Studio configuration: the one list of environment variables.
#
# The same names drive the local install and the Cloud Run deployment. Locally,
# copy this file to .env; scripts/run.sh and scripts\run.cmd load it.
#
# .env is ignored by git. Never commit a filled-in copy.
# Blank or absent means "off": every variable below is optional.

# ---------------------------------------------------------------------------
# Where the app runs
# ---------------------------------------------------------------------------
# Writable state directory. Local default is .data in the checkout.
INV_STUDIO_DATA=
# Local port. The server always binds loopback (127.0.0.1) in the local install.
# Blank means 8765, which is what scripts/run.sh and scripts\run.cmd use.
INV_STUDIO_PORT=

# ---------------------------------------------------------------------------
# Deployment mode: the one switch between the local install and the cloud
# ---------------------------------------------------------------------------
# Leave blank for local: no sign-in, SQLite in INV_STUDIO_DATA, files on disk.
# Set to 1 for the hosted workspace: Entra ID sign-in, PostgreSQL, blob storage.
INV_STUDIO_CLOUD=
# Cloud only, and required when INV_STUDIO_CLOUD=1.
INV_STUDIO_BUCKET=
INV_STUDIO_ALLOWED_ORIGINS=
# Cloud only. Extra Host patterns the server answers, comma-separated (for example
# *.<environment domain> for Azure revision addresses). *.run.app and the origins above are always allowed.
INV_STUDIO_ALLOWED_HOSTS=
# Cloud only, and required: the workforce Entra ID tenant and the app registration
# the browser signs in with (both GUIDs). Public values, not credentials.
INV_STUDIO_ENTRA_TENANT_ID=
INV_STUDIO_ENTRA_CLIENT_ID=
# Cloud only, optional. Display names of the two Entra groups that hold the admin
# and member app roles, shown on the Users screen. They grant nothing.
INV_STUDIO_ENTRA_ADMIN_GROUP_NAME=
INV_STUDIO_ENTRA_MEMBER_GROUP_NAME=
# Settings of the Firebase build. Leave them unset: with INV_STUDIO_CLOUD=1 the app
# refuses to start if any of these, or any INV_STUDIO_FIREBASE_* setting, is set.
#   GOOGLE_CLOUD_PROJECT
#   INV_STUDIO_ALLOWED_EMAILS
#   INV_STUDIO_MEMBER_EMAILS
# Cloud only, and injected from Secret Manager by the deploy (docs/RUNBOOK.md).
# Never put these in an env file:
#   INV_STUDIO_DATABASE_URL
#   INV_STUDIO_VAULT_KEY

# ---------------------------------------------------------------------------
# File storage (cloud only)
# ---------------------------------------------------------------------------
# Where uploads and exports live: gcs (default, the bucket above) or azure, the
# Azure Blob Storage container used by the Container Apps deployment.
INV_STUDIO_STORAGE_BACKEND=
# Azure backend only. Give either the full account URL, or the account name
# (with an optional suffix; blank means blob.core.windows.net).
INV_STUDIO_AZURE_STORAGE_URL=
INV_STUDIO_AZURE_STORAGE_ACCOUNT=
INV_STUDIO_AZURE_STORAGE_SUFFIX=
# Azure backend only, and for a laptop or Azurite. Blank in Container Apps,
# which authenticates with the container's managed identity. A connection
# string carries a key: never commit a filled-in copy.
INV_STUDIO_AZURE_STORAGE_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# AI readers
# ---------------------------------------------------------------------------
# All six readers (OpenAI, Anthropic, Azure AI Foundry, ChatGPT, Claude Code,
# Vertex AI) are selectable in both local and cloud. A reader is offered when it
# is connected, and connecting is configuration: either the Engines & AI page
# (administrators) or the variables below. OpenAI, Anthropic, ChatGPT and
# Claude Code are connected in the UI only, because their credentials are
# per-operator.

# Azure AI Foundry. Either set both of these, or connect it in the UI; a UI
# connection wins. The endpoint must be an Azure resource host
# (*.openai.azure.com, *.services.ai.azure.com, *.cognitiveservices.azure.com).
# Select the deployment name as the model. In the cloud the key is mounted from
# Secret Manager, never put in an env file.
INV_STUDIO_AZURE_ENDPOINT=
INV_STUDIO_AZURE_API_KEY=
# The deployment the hosted workspace reads with when no model has been chosen.
INV_STUDIO_AZURE_DEPLOYMENT=

# Google Vertex AI, through the runtime service identity (no API key).
# Works locally too, with application-default credentials.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
VERTEX_MODEL=

# Which managed reader is the default when both Vertex and Azure are
# configured: vertex (default when Vertex is configured) or azure.
INV_STUDIO_DEFAULT_PROVIDER=

# Dollars per million tokens for the spend ledger, as JSON keyed by model or
# deployment name, e.g. {"your-deployment-name": {"input": 2.0, "output": 8.0, "cached": 0.5}}.
# An unpriced model is still counted, and shown as unpriced. See app/costs.py
# for the shape.
INV_STUDIO_AI_PRICES=

# ---------------------------------------------------------------------------
# Reader behaviour
# ---------------------------------------------------------------------------
# Seconds a local OCR engine may run.
INV_ENGINE_TIMEOUT=
# Address-space cap in MB for each local reader. Blank or 0 means no cap (the
# default): PyTorch and PaddleOCR reserve far more address space than they use.
INV_STUDIO_READER_MAX_AS_MB=
# Most MB the app reads of one message from a job's checks process. Blank, 0
# or not a number means 64; there is always a cap.
INV_STUDIO_JOB_MESSAGE_MB=
# Concurrent local OCR jobs. Raise only with the memory to match.
INV_LOCAL_OCR_CONCURRENCY=
# Concurrent AI reads. Blank means 4.
INV_AI_CONCURRENCY=
# Seconds a reader whose model download the network refused is skipped for,
# so one blocked reader does not slow every upload down. It is tried again
# after that, with no restart. Blank means 900; 0 never skips it.
INV_MODELS_BLOCKED_SECONDS=
# Unfinished jobs the server admits before it refuses an upload. Blank means
# 500, the same as the largest processing plan.
INV_STUDIO_MAX_QUEUED=
# Queue workers. Blank means INV_AI_CONCURRENCY + INV_LOCAL_OCR_CONCURRENCY.
INV_STUDIO_WORKERS=
# Set to 0 to stop learning from verified invoices.
INV_STUDIO_LEARN=
INV_STUDIO_LEARNED_TEMPLATES=
# Cross-check an invoice the local engines read completely. Costs an AI call.
INV_STUDIO_AI_CROSS_CHECK=
INV_STUDIO_VERIFY_SCANS=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# JSON logs. On by default in cloud mode, off locally.
INV_STUDIO_JSON_LOGS=
# Set to 0 to never take over jobs whose process stopped (used by preflight
# checks against the live database; leave blank otherwise).
INV_STUDIO_RECOVER_JOBS=

# ---------------------------------------------------------------------------
# Test only
# ---------------------------------------------------------------------------
# Loads the synthetic demo reference data on start. The server refuses to start
# with INV_STUDIO_CLOUD=1, so it never reaches the hosted workspace.
INV_STUDIO_DEMO_REFERENCES=
