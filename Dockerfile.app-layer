# App-only release: an existing, verified image plus the app/ tree of the commit being shipped.
# Use it only when app/ is the only shipped path that changed since BASE was built; check with
#   git diff --stat <base commit>..HEAD -- app samples scripts/warm_ocr.py pyproject.toml constraints.txt Dockerfile README.md
# Dependencies, OCR models and everything outside /opt/inv-studio/app stay exactly as in BASE (no re-download,
# no warm-up re-run). The old app/ is removed first, so files deleted in the commit do not linger.
#   docker build -f Dockerfile.app-layer --build-arg BASE=<image>@sha256:<digest> -t <image>:<tag> .
# BASE must be pinned by digest; check the value first with
#   python3 tools/security/check_base_image.py Dockerfile.app-layer --build-arg BASE=<image>@sha256:<digest>
ARG BASE
FROM ${BASE}
USER root
RUN rm -rf /opt/inv-studio/app
COPY app /opt/inv-studio/app
# Model folders read-only for the app's account, and no model hub lookups (N6, N8; the same as the Dockerfile).
RUN set -e; \
    rapidocr="$(python -c 'import importlib.util; from pathlib import Path; print(Path(importlib.util.find_spec("rapidocr").origin).parent/"models")')"; \
    for d in /home/studio/.cache/huggingface /home/studio/.paddlex/official_models "$rapidocr"; do \
        test -d "$d"; chown -R root:root "$d"; chmod -R a-w "$d"; \
    done
USER 1000:1000
ENV HF_HUB_OFFLINE=1
