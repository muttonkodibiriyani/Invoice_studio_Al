# Deploy kit for the first Azure deploy: scripts/azure_deploy.py reads it.
#
# One line per placeholder of the tm8 doc "Azure access request" (01a187ad-7fd4, v4), in its order, with
# the access-request line it comes from. Copy it outside git, fill in what the platform team sends back,
# and keep it readable only by you:
#
#   mkdir -p ~/inv-studio-azure && chmod 700 ~/inv-studio-azure
#   cp infra/azure/deploy-kit.example.env ~/inv-studio-azure/deploy-kit.env && chmod 600 ~/inv-studio-azure/deploy-kit.env
#
# The script refuses to run while any value is still <LIKE_THIS> or empty. A line that does not apply
# (for example SHARED_ACR_LOGIN_SERVER when the registry is our own) is written n/a, never left blank.
# Names and ids only: no password, key or token ever goes in this file. The database admin password and
# the vault key are typed in hidden when the script asks for them.
#
# "Bicep" says which main.bicep parameter the value fills. "(new)" means main.bicep does not have that
# parameter yet: the script passes it only once the template declares it, and says so when it skips it.

# A. Subscription, resource group, region
AZ_SUBSCRIPTION_ID=<AZ_SUBSCRIPTION_ID>          # A1  checked: the signed-in subscription
AZ_TENANT_ID=<AZ_TENANT_ID>                      # A1  checked: the signed-in tenant
AZ_RESOURCE_GROUP=<AZ_RESOURCE_GROUP>            # A2  checked: exists, empty, in AZ_REGION
AZ_REGION=<AZ_REGION>                            # A3  Bicep location
AZ_REQUIRED_TAGS=<AZ_REQUIRED_TAGS>              # A4  Bicep tags, as JSON: {"costCentre":"...","owner":"..."}
AZ_NAME_PREFIX=<AZ_NAME_PREFIX>                  # A4  Bicep namePrefix: 3-9 lower-case letters and digits
AZ_POLICY_EXEMPTIONS=<AZ_POLICY_EXEMPTIONS>      # A5  the exemption reference, or n/a; the what-if checks policy

# B. Roles for Tarkesh
TARKESH_UPN=<TARKESH_UPN>                        # B1  checked: the signed-in user

# E. Microsoft Entra ID sign-in app
ENTRA_APP_DISPLAY_NAME=<ENTRA_APP_DISPLAY_NAME>  # E1  record only
ENTRA_APP_CLIENT_ID=<ENTRA_APP_CLIENT_ID>        # E1  Bicep (new) entraClientId
ENTRA_REDIRECT_URI_OWNER=<ENTRA_REDIRECT_URI_OWNER>  # E2  who adds the redirect URI after the deploy
# E3 is not here: the role values are the literal admin and member in code (Entra design 01a187ad-16bc §7).
ENTRA_GROUP_ADMIN=<ENTRA_GROUP_ADMIN>            # E4  record only: object id, assigned to the admin app role in Entra
ENTRA_GROUP_ADMIN_NAME=<ENTRA_GROUP_ADMIN_NAME>  # E4  Bicep (new) entraAdminGroupName: display name on the Users screen, or n/a
ENTRA_GROUP_MEMBER=<ENTRA_GROUP_MEMBER>          # E4  record only: object id, assigned to the member app role in Entra
ENTRA_GROUP_MEMBER_NAME=<ENTRA_GROUP_MEMBER_NAME>  # E4  Bicep (new) entraMemberGroupName: display name, or n/a
ENTRA_GROUP_OWNERS=<ENTRA_GROUP_OWNERS>          # E4  record only
ENTRA_CA_NOTES=<ENTRA_CA_NOTES>                  # E6  record only
ENTRA_TOKEN_LIFETIME=<ENTRA_TOKEN_LIFETIME>      # E7  record only: the token-lifetime policy, or tenant default
ENTRA_CLOUD=<ENTRA_CLOUD>                        # E8  checked: must be public (login.microsoftonline.com)

# F. GitHub OIDC deploy identity (later image builds; not used by the first deploy)
DEPLOY_CLIENT_ID=<DEPLOY_CLIENT_ID>              # F1  GitHub secret AZURE_CLIENT_ID
GH_ENV_REVIEWERS=<GH_ENV_REVIEWERS>              # F4  record only
ACR_TASKS_NETWORK_PATH=<ACR_TASKS_NETWORK_PATH>  # F5  record only, or n/a

# G. Cloud Shell
CLOUDSHELL_STORAGE=<CLOUDSHELL_STORAGE>          # G1  record only, or ephemeral
CLOUDSHELL_VNET=<CLOUDSHELL_VNET>                # G2  record only, or n/a

# H. Target round: network, firewall, DNS, registry, Citadel
SPOKE_VNET_CIDR=<SPOKE_VNET_CIDR>                # H1  Bicep networkAddressPrefix (a /24)
HUB_VNET_ID=<HUB_VNET_ID>                        # H2  Bicep hubVnetId: the spoke side of the peering, or n/a (none)
HUB_DNS_IP=<HUB_DNS_IP>                          # H2  Bicep dnsServers: one IP, or several comma-separated, or n/a (Azure DNS)
HUB_FIREWALL_IP=<HUB_FIREWALL_IP>                # H3  Bicep (new) egressFirewallIp
FW_RULE_COLLECTION=<FW_RULE_COLLECTION>          # H4  record only
PDNS_ZONE_IDS=<PDNS_ZONE_IDS>                    # H5  Bicep (new) privateDnsZoneIds, as JSON {zone: id}
AMPLS_ID=<AMPLS_ID>                              # H5  Bicep (new) amplsId
REGISTRY_CHOICE=<REGISTRY_CHOICE>                # H6  record only: a (own ACR) or b (shared)
SHARED_ACR_LOGIN_SERVER=<SHARED_ACR_LOGIN_SERVER>  # H6  record only, or n/a
CITADEL_ENDPOINT=<CITADEL_ENDPOINT>              # H7  Bicep foundryEndpoint
CITADEL_DEPLOYMENT=<CITADEL_DEPLOYMENT>          # H7  Bicep foundryDeployment
CITADEL_AUTH_MODE=<CITADEL_AUTH_MODE>            # H7  Bicep (new) foundryAuthMode
CITADEL_APPROVAL_REF=<CITADEL_APPROVAL_REF>      # H7  record only
APP_HOSTNAME=<APP_HOSTNAME>                      # H8  Bicep extraAllowedOrigins (https://APP_HOSTNAME), or n/a
INGRESS_ENTRY=<INGRESS_ENTRY>                    # H8  record only
TLS_CERT_REF=<TLS_CERT_REF>                      # H8  record only
LAW_ID=<LAW_ID>                                  # H9  Bicep (new) existingLogWorkspaceId, or n/a
LOG_RETENTION_DAYS=<LOG_RETENTION_DAYS>          # H9  Bicep logRetentionInDays
ENTRA_SIGNIN_LOGS=<ENTRA_SIGNIN_LOGS>            # H10 record only: Entra sign-in logs to Log Analytics, or n/a
